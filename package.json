{
  "name": "bending-qrcode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "lint": "eslint src tests vite.config.js",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "8.2.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "jsqr": "1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "qrcode": "1.5.4",
    "vite": "6.4.4",
    "vite-plugin-singlefile": "2.3.4"
  }
}
